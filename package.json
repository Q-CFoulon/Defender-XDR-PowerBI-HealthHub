{
  "name": "defender-xdr-powerbi-healthhub",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone API pipeline for Microsoft Defender XDR and Secure Score data feeding Power BI dashboards",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "refresh:once": "tsx src/index.ts --once",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "service:install": "powershell -ExecutionPolicy Bypass -File .\\scripts\\Install-HealthHubWindowsService.ps1",
    "service:uninstall": "powershell -ExecutionPolicy Bypass -File .\\scripts\\Uninstall-HealthHubWindowsService.ps1",
    "entra:register": "powershell -ExecutionPolicy Bypass -File .\\scripts\\Register-HealthHubEnterpriseApp.ps1",
    "deploy:client": "powershell -ExecutionPolicy Bypass -File .\\scripts\\Deploy-HealthHubClient.ps1"
  },
  "dependencies": {
    "axios": "^1.9.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.1.0",
    "node-cron": "^3.0.3",
    "pino": "^9.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "^5.1.3",
    "@types/node": "^22.10.2",
    "@types/node-cron": "^3.0.11",
    "eslint": "^10.3.0",
    "prettier": "^3.8.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.59.3",
    "vitest": "^4.1.6"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
