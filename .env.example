# ── Server ──────────────────────────────────────────────────
APP_PORT=4010                          # [OPTIONAL] Default: 4010
NODE_ENV=development                   # [OPTIONAL] development | production
REFRESH_CRON=0 */30 * * * *           # [OPTIONAL] cron schedule for auto-refresh
APP_BASE_DIR=                          # [OPTIONAL] override base directory
DATA_DIRECTORY=                        # [OPTIONAL] snapshot storage path

# ── Azure AD / Entra ID (REQUIRED) ──────────────────────────
# Run scripts/Register-HealthHubEnterpriseApp.ps1 to create these
TENANT_ID=your-entra-tenant-id         # [REQUIRED]
CLIENT_ID=your-app-registration-client-id   # [REQUIRED]
CLIENT_SECRET=your-app-registration-client-secret  # [REQUIRED]

# ── Defender XDR API ────────────────────────────────────────
# Defaults work for most tenants. Some endpoints require
# Exposure Management or Defender for Cloud licensing.
DEFENDER_API_BASE_URL=https://api.security.microsoft.com
DEFENDER_SCOPE=https://api.security.microsoft.com/.default
DEFENDER_INITIATIVES_PATH=/api/recommendations
DEFENDER_TOP_INITIATIVES_PATH=/api/vulnerabilities?$top=10
DEFENDER_VULNERABILITY_OVERVIEW_PATH=/api/exposureScore
DEFENDER_CLOUD_SCORE_PATH=/api/configurationScore

# ── Microsoft Graph API ─────────────────────────────────────
GRAPH_API_BASE_URL=https://graph.microsoft.com/v1.0
GRAPH_SCOPE=https://graph.microsoft.com/.default
GRAPH_SECURE_SCORES_PATH=/security/secureScores?$top=1

# ── MCP Bridge (OPTIONAL: AI remediation) ───────────────────
# Leave empty to use built-in local recommendations.
# Set to your MCP bridge server URL for AI-powered recommendations.
MCP_BRIDGE_URL=                        # [OPTIONAL] e.g. http://localhost:5055
MCP_BRIDGE_API_KEY=                    # [OPTIONAL] Bearer token for MCP bridge

# ── Admin & Security ────────────────────────────────────────
ADMIN_API_KEY=                         # [OPTIONAL] protects /admin and /api/admin/*
CORS_ALLOWED_ORIGINS=                  # [OPTIONAL] comma-separated origins

# ── Power BI Push (OPTIONAL: real-time dataset) ─────────────
# Leave empty to disable Power BI push. See powerbi/power-query-sample.m
# for pull-based alternative.
POWERBI_PUSH_DATASET_URL=              # [OPTIONAL] streaming dataset push URL
POWERBI_PUSH_BEARER_TOKEN=             # [OPTIONAL] auth token for push
